{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",
  "properties": {
    "ID": { "type": "string" },
    "DisplayName": { "type": "string" },
    "ArenaSceneName": { "type": "string" },
    "ArenaPosition": { "$ref": "#/$defs/Vector3" },
    "CanRespawnOnArena": { "type": "boolean" },
    "RequireHardSceneReload": { "type": "boolean" },
    "RespawnFlags": { "$ref": "#/$defs/BossRespawnFlags" }
  },

  "$defs": {
    "Vector3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },

    "SceneBool": {
      "type": "object",
      "properties": {
        "SceneName": { "type": "string" },
        "ID": { "type": "string" },
        "Value": { "type": "boolean" }
      }
    },

    "SceneInt": {
      "type": "object",
      "properties": {
        "SceneName": { "type": "string" },
        "ID": { "type": "string" },
        "Value": { "type": "integer" },
        "Mutator": { "type": "integer" }
      }
    },

    "BossRespawnFlags": {
      "type": "object",
      "properties": {
        "PlayerDataBools": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "SceneBools": {
          "type": "array",
          "items": { "$ref": "#/$defs/SceneBool" }
        },
        "SceneInts": {
          "type": "array",
          "items": { "$ref": "#/$defs/SceneInt" }
        }
      }
    }
  }
}